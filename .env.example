PORT=5000
NODE_ENV=development

# Anonymous sessions (POST /api/sessions issues a token per visitor)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Max files one session can upload
MAX_FILES_PER_SESSION=20
# Frontend origins allowed to call the API, comma-separated. Required in production.
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (0 when none), so rate limits see real client IPs
TRUST_PROXY=0

# MongoDB (docker-compose uses MONGO_USER/MONGO_PASSWORD for the root user)
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=rag_docs_chat
# Optional: full connection string (e.g. Atlas mongodb+srv://...). Overrides the values above.
MONGODB_URI=

# Gemini API (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# 128-3072. Must match the vector search index; changing it requires re-embedding.
GEMINI_EMBEDDING_DIMENSIONS=768

# Uploaded files processed at the same time by this process (default 2).
# Set to 0 to process them in a separate `npm run worker` process instead.
FILE_WORKER_CONCURRENCY=2

# Text chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# File storage provider: local | supabase
STORAGE_PROVIDER=local
# Used when STORAGE_PROVIDER=local (relative to the project root)
LOCAL_STORAGE_DIR=uploads

# Used when STORAGE_PROVIDER=supabase: Supabase Storage via its S3-compatible API
# Dashboard > Storage > S3 Connection: copy the endpoint and region, create access keys
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=documents
